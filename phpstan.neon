includes:
    - vendor/flarum/phpstan/extension.neon

parameters:
    # One process: flarum/phpstan's bootstrap installs a test forum the first
    # time it runs, and parallel workers each start that install at once on a
    # fresh checkout (CI), failing with Install\StepFailed.
    parallel:
        maximumNumberOfProcesses: 1
    level: 6
    paths:
        - extend.php
        - src
    # Implement Page Builder's and Kiosk's interfaces: only there when they're
    # installed (extend.php checks first).
    databaseMigrationsPath: [migrations]
    excludePaths:
        - *.blade.php
        - src/Widget
        - src/Kiosk
    # Kiosk and flarum/tags are optional: their classes load only when they're enabled.
    ignoreErrors:
        - '#Ernestdefoe\\Kiosk\\#'
        - '#Flarum\\Discussion\\Discussion::tags\(\)#'
